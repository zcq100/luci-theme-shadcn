#
# Standalone OpenWrt package Makefile for luci-theme-shadcn.
#
# Use this when building outside a LuCI feed checkout, e.g. in the OpenWrt SDK:
#
#   mkdir -p package/luci-theme-shadcn
#   cp -a htdocs ucode root Makefile.sdk package/luci-theme-shadcn/
#   mv package/luci-theme-shadcn/Makefile.sdk package/luci-theme-shadcn/Makefile
#   make package/luci-theme-shadcn/compile
#
# The regular Makefile targets the LuCI feed layout (feeds/luci/themes/...).
#

include $(TOPDIR)/rules.mk

PKG_NAME:=luci-theme-shadcn
PKG_VERSION:=1.0.7
PKG_RELEASE:=1

PKG_LICENSE:=Apache-2.0
PKG_MAINTAINER:=luci-theme-shadcn <luci-theme-shadcn@example.invalid>

PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)

include $(INCLUDE_DIR)/package.mk

define Package/luci-theme-shadcn
  SECTION:=luci
  CATEGORY:=LuCI
  SUBMENU:=Themes
  TITLE:=shadcn Theme (responsive, light and dark mode)
  DEPENDS:=luci-base
  PKGARCH:=all
endef

define Package/luci-theme-shadcn/description
 A shadcn-inspired responsive LuCI theme with light and dark modes.
endef

define Package/luci-theme-shadcn/postinst
#!/bin/sh
[ -n "$${IPKG_INSTROOT}" ] || {
	if [ -x /etc/uci-defaults/30_luci-theme-shadcn ]; then
		sh /etc/uci-defaults/30_luci-theme-shadcn
		rm -f /etc/uci-defaults/30_luci-theme-shadcn
	fi

	rm -f /tmp/luci-indexcache.*
	rm -rf /tmp/luci-modulecache/
	/etc/init.d/rpcd reload 2>/dev/null
	exit 0
}
endef

define Package/luci-theme-shadcn/postrm
#!/bin/sh
[ -n "$${IPKG_INSTROOT}" ] || {
	uci -q delete luci.themes.SHADCN

	if [ "$$(uci -q get luci.main.mediaurlbase)" = "/luci-static/shadcn" ]; then
		uci -q set luci.main.mediaurlbase="/luci-static/bootstrap"
	fi

	uci commit luci
}
endef

define Build/Prepare
	mkdir -p $(PKG_BUILD_DIR)
	$(CP) ./htdocs $(PKG_BUILD_DIR)/
	$(CP) ./ucode $(PKG_BUILD_DIR)/
	$(CP) ./root $(PKG_BUILD_DIR)/
endef

define Build/Compile
endef

define Package/luci-theme-shadcn/install
	$(INSTALL_DIR) $(1)/www
	$(CP) $(PKG_BUILD_DIR)/htdocs/* $(1)/www/

	$(INSTALL_DIR) $(1)/usr/share/ucode/luci
	$(CP) $(PKG_BUILD_DIR)/ucode/* $(1)/usr/share/ucode/luci/

	$(CP) $(PKG_BUILD_DIR)/root/* $(1)/
endef

$(eval $(call BuildPackage,luci-theme-shadcn))

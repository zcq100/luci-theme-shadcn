	{% if (!blank_page): %}
					<footer class="shadcn-footer">
						<span>
							{{ _('Powered by') }}
							<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} {{ version.luciversion }}</a>
							/
							<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
						</span>
						{% if (lua_active): %}
							<span class="shadcn-footer-note">{{ _('Lua compatibility mode active') }}</span>
						{% endif %}
					</footer>
				</div><!-- /#maincontent -->
			</div><!-- /#shadcn-main -->
		</div><!-- /#shadcn-shell -->

		<script>L.require('menu-shadcn')</script>
	{% endif %}
	</body>
</html>

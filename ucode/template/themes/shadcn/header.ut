{#
 luci-theme-shadcn — page header
 Based on the LuCI Bootstrap theme header (Apache-2.0).
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">
		<meta name="darkreader-lock">
		<script>
			/* Apply the saved colour scheme (or follow the OS) before first paint. */
			(function () {
				var mq = window.matchMedia('(prefers-color-scheme: dark)');

				function apply() {
					var pref = null;

					try { pref = window.localStorage.getItem('shadcn-theme'); } catch (e) {}

					document.documentElement.setAttribute('data-darkmode',
						pref === 'dark' ? 'true' :
						pref === 'light' ? 'false' :
						(mq.matches ? 'true' : 'false'));
				}

				apply();

				if (mq.addEventListener)
					mq.addEventListener('change', apply);
			})();
		</script>
		<link rel="stylesheet" href="{{ media }}/cascade.css?v=1.0.7">
		<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		{% if (!blank_page): %}
		<div id="shadcn-shell">
			<aside id="shadcn-sidebar">
				<a class="shadcn-brand" href="/">
					<img class="shadcn-brand-logo" src="{{ media }}/logo.svg" alt="" width="36" height="36">
					<span class="shadcn-brand-text">
						<strong>{{ striptags(boardinfo.hostname ?? '?') }}</strong>
						<small>{{ striptags(boardinfo.model ?? _('OpenWrt')) }}</small>
					</span>
				</a>

				<nav id="topmenu" class="shadcn-nav" aria-label="{{ _('Main menu') }}">
					<ul id="modemenu" class="shadcn-modes" style="display:none"></ul>
				</nav>
			</aside>
			<div class="shadcn-scrim" id="shadcn-scrim" hidden></div>

			<div id="shadcn-main">
				<header class="shadcn-topbar">
					<button type="button" class="shadcn-icon-btn shadcn-nav-toggle" id="shadcn-nav-toggle" aria-label="{{ _('Toggle navigation') }}" aria-expanded="false">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<path d="M4 6h16M4 12h16M4 18h16"/>
						</svg>
					</button>

					<div class="shadcn-topbar-title" id="shadcn-page-title"></div>

					<div class="shadcn-topbar-actions">
						<div id="indicators" class="shadcn-indicators"></div>

						<button type="button" class="shadcn-icon-btn shadcn-theme-toggle" id="shadcn-theme-toggle" aria-label="{{ _('Toggle dark mode') }}">
							<span class="shadcn-icon-moon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
								</svg>
							</span>
							<span class="shadcn-icon-sun">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="12" cy="12" r="4"/>
									<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
								</svg>
							</span>
						</button>
					</div>
				</header>

				<div id="maincontent" class="shadcn-content" role="main">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<h4>{{ _('No password set!') }}</h4>
							<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							{% if (dispatcher.lookup('admin/system/admin')): %}
								<div class="right"><a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == 'initramfs'): %}
						<div class="alert-message warning">
							<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
							<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							{% if (dispatcher.lookup('admin/system/flash')): %}
								<div class="right"><a class="btn" href="{{ dispatcher.build_url('admin/system/flash') }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
		{% endif %}
